{
  "expo": {
    "name": "Everquest",
    "slug": "Everquest",
    "scheme": "everquest",
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#725CFF",
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permita o acesso à câmera para ler convites de amizade.",
          "recordAudioAndroid": false
        }
      ],
      "expo-status-bar",
      "expo-image",
      "expo-secure-store"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/favicon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "br.com.everquest.app",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#725CFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "br.com.everquest.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "66200201-f72a-4905-868c-b3431dcf8641"
      }
    }
  }
}
